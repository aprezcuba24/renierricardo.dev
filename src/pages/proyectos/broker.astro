---
const title = 'Broker — Conecta tu catálogo con tus vendedores';
const description =
  'Plataforma B2B de prelanzamiento: publica tu catálogo, recibe pedidos de tus vendedores y coordina precios y stock en un solo lugar.';
const image = '/proyectos/broker/01-backoffice-dashboard.png';
const site = 'https://renierricardo.dev';
const email = 'aprezcuba24@gmail.com';
const phone = '53024637';
const whatsapp = `https://wa.me/53${phone}?text=${encodeURIComponent('Hola, quiero registrarme como proveedor en Broker (prelanzamiento).')}`;
const mailto = `mailto:${email}?subject=${encodeURIComponent('Registro prelanzamiento Broker')}&body=${encodeURIComponent('Nombre:\nEmpresa:\nEmail:\nTeléfono (opcional):\n')}`;
const registerHref = whatsapp;

const problems = [
  'Catálogos y precios desactualizados entre tu equipo y tus vendedores.',
  'Pedidos por chat, Excel o WhatsApp: lentos y con errores.',
  'Cuesta coordinar stock y disponibilidad con quien te vende.',
];

const providerBenefits = [
  {
    title: 'Catálogo centralizado',
    text: 'Publica y gestiona tu catálogo (precios, stock, disponibilidad).',
    icon: 'catalog',
  },
  {
    title: 'Pedidos ordenados',
    text: 'Recibe pedidos de tus vendedores de forma ordenada.',
    icon: 'orders',
  },
  {
    title: 'Tú traes a tus vendedores',
    text: 'Comparte Broker con tus vendedores: ellos piden sobre tu catálogo.',
    icon: 'share',
  },
  {
    title: 'API cuando la necesites',
    text: 'Integra con tus sistemas cuando lo necesites (API).',
    icon: 'api',
  },
];

const steps = [
  {
    n: '1',
    title: 'Publicas',
    text: 'Tu catálogo en Broker.',
  },
  {
    n: '2',
    title: 'Compartes',
    text: 'La app con tus vendedores.',
  },
  {
    n: '3',
    title: 'Recibes',
    text: 'Pedidos y creces con ellos.',
  },
];

const providerScreens = [
  {
    src: '/proyectos/broker/01-backoffice-dashboard.png',
    title: 'Dashboard',
    text: 'Tu panel: actividad, pedidos y visión general.',
  },
  {
    src: '/proyectos/broker/02-backoffice-products.png',
    title: 'Productos',
    text: 'Gestiona productos, precios y disponibilidad.',
  },
  {
    src: '/proyectos/broker/03-backoffice-orders.png',
    title: 'Pedidos',
    text: 'Pedidos de tus vendedores, en un solo lugar.',
  },
];

const sellerScreens = [
  {
    src: '/proyectos/broker/04-seller-products.png',
    title: 'Catálogo',
    text: 'Tus vendedores exploran tu catálogo y piden.',
  },
  {
    src: '/proyectos/broker/05-seller-cart.png',
    title: 'Carrito',
    text: 'Arman el pedido y te lo envían.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}${image}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/proyectos/broker`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-lg">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
        <a href="/" class="text-sm text-slate-400 transition hover:text-white">← renierricardo.dev</a>
        <div class="flex items-center gap-2">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-500/20 text-sm font-extrabold text-teal-300 ring-1 ring-teal-400/40"
            >B</span
          >
          <span class="hidden text-sm font-semibold sm:inline">Broker</span>
        </div>
        <a
          href={registerHref}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-teal-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-teal-400"
        >
          Quiero registrarme
        </a>
      </div>
    </header>

    <main>
      <!-- 1. Hero -->
      <section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-24">
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-teal-900/40 via-slate-950 to-slate-950"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.06]"
          style="background-image: radial-gradient(rgba(45,212,191,0.55) 1px, transparent 1px); background-size: 24px 24px;"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-24 top-16 h-[28rem] w-[28rem] rounded-full bg-cyan-500/12 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute -left-16 bottom-0 h-72 w-72 rounded-full bg-teal-500/10 blur-3xl"
        >
        </div>

        <div class="relative mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-3xl text-center">
            <p
              class="mb-5 inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-300 animate-fade-in"
            >
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-teal-400"></span>
              Prelanzamiento · Proveedores
            </p>
            <h1
              class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl animate-rise"
            >
              Broker
            </h1>
            <p class="mx-auto mt-5 max-w-xl text-xl leading-relaxed text-slate-300 sm:text-2xl animate-rise-delay">
              Conecta tu catálogo con tus vendedores. Sin fricción.
            </p>
            <div class="mt-9 flex flex-wrap justify-center gap-3 animate-rise-delay-2">
              <a
                href={registerHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-teal-500 px-7 py-3.5 text-sm font-bold text-slate-950 shadow-lg shadow-teal-500/25 transition hover:bg-teal-400 hover:shadow-teal-400/30"
              >
                Quiero registrarme
              </a>
              <a
                href="#vista-previa"
                class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
              >
                Ver el producto
              </a>
            </div>
          </div>

          <div class="relative mx-auto mt-14 max-w-5xl animate-rise-delay-2">
            <div
              class="absolute -inset-4 rounded-2xl bg-gradient-to-br from-teal-500/20 to-cyan-500/5 blur-2xl"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-xl border border-white/10 bg-slate-900 shadow-2xl shadow-teal-950/40 ring-1 ring-white/10"
            >
              <div class="flex items-center gap-2 border-b border-white/10 bg-slate-900/90 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                <span
                  class="ml-3 truncate rounded-md bg-white/5 px-3 py-1 text-[11px] text-slate-400"
                  >app.broker · panel del proveedor</span
                >
              </div>
              <img
                src="/proyectos/broker/01-backoffice-dashboard.png"
                alt="Dashboard del proveedor en Broker"
                class="block w-full"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- 2. El problema -->
      <section class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">El problema</h2>
            <p class="mt-4 text-slate-300">Lo que frena hoy a proveedores y sus redes de venta.</p>
          </div>
          <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-3">
            {
              problems.map((p) => (
                <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm leading-relaxed text-slate-300 transition hover:border-teal-500/25 hover:bg-white/[0.05]">
                  <span class="mb-3 block text-teal-400">—</span>
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 3. Qué es -->
      <section class="py-20 sm:py-24">
        <div class="mx-auto max-w-3xl px-5 text-center">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Qué es</h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-300">
            <strong class="font-semibold text-white">Broker</strong> es una plataforma B2B que conecta
            proveedores con vendedores: un solo lugar para catálogo, pedidos y relación comercial.
          </p>
        </div>
      </section>

      <!-- 4. Para proveedores -->
      <section class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Para proveedores</h2>
            <p class="mt-4 text-slate-300">
              Tú publicas. Tus vendedores piden. El mensaje es claro: tú los traes.
            </p>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              providerBenefits.map((f) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-teal-500/30 hover:bg-white/[0.05]">
                  <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-teal-500/15 text-teal-400">
                    {f.icon === 'catalog' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M4 6h16M4 12h16M4 18h10" />
                      </svg>
                    )}
                    {f.icon === 'orders' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                        <path d="M9 12h6M9 16h4" />
                      </svg>
                    )}
                    {f.icon === 'share' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <circle cx="18" cy="5" r="3" />
                        <circle cx="6" cy="12" r="3" />
                        <circle cx="18" cy="19" r="3" />
                        <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" />
                      </svg>
                    )}
                    {f.icon === 'api' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M8 9l-4 3 4 3M16 9l4 3-4 3M14 4l-4 16" />
                      </svg>
                    )}
                  </div>
                  <h3 class="font-semibold text-white">{f.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. Cómo funciona -->
      <section class="py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Cómo funciona</h2>
            <p class="mt-4 text-slate-300">
              Los vendedores llegan de forma orgánica: tú los traes.
            </p>
          </div>

          <div class="mt-14 overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 p-6 sm:p-10">
            <div class="flex flex-col items-stretch gap-4 md:flex-row md:items-center md:justify-center">
              {
                steps.map((s, i) => (
                  <>
                    <div class="flex flex-1 flex-col items-center">
                      <div
                        class:list={[
                          'w-full max-w-[200px] rounded-2xl p-5 text-center shadow-lg',
                          i === 1
                            ? 'border-2 border-cyan-500/50 bg-slate-900'
                            : 'bg-gradient-to-br from-teal-600 to-teal-800 shadow-teal-900/40',
                        ]}
                      >
                        <div
                          class:list={[
                            'mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl text-lg font-extrabold',
                            i === 1 ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white/15 text-white',
                          ]}
                        >
                          {s.n}
                        </div>
                        <p
                          class:list={[
                            'text-lg font-bold',
                            i === 1 ? 'text-cyan-300' : 'text-white',
                          ]}
                        >
                          {s.title}
                        </p>
                        <p
                          class:list={[
                            'mt-1 text-sm',
                            i === 1 ? 'text-slate-400' : 'text-teal-100/80',
                          ]}
                        >
                          {s.text}
                        </p>
                      </div>
                    </div>
                    {i < steps.length - 1 && (
                      <div class="flex justify-center px-2 md:px-3">
                        <svg
                          class="hidden h-6 w-12 text-teal-500 md:block"
                          fill="none"
                          viewBox="0 0 48 24"
                        >
                          <path
                            d="M2 12h36M30 4l12 8-12 8"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <svg class="h-8 w-6 text-teal-500 md:hidden" fill="none" viewBox="0 0 24 32">
                          <path
                            d="M12 2v22M4 18l8 8 8-8"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </div>
                    )}
                  </>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 6. Vista previa del producto -->
      <section id="vista-previa" class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Vista previa del producto</h2>
            <p class="mt-4 text-slate-300">Portal del proveedor y lo que ven tus vendedores.</p>
          </div>

          <div class="mt-14">
            <p class="mb-6 text-xs font-semibold uppercase tracking-widest text-teal-400/90">
              Portal del proveedor
            </p>
            <div class="grid gap-8 lg:grid-cols-3">
              {
                providerScreens.map((s) => (
                  <figure class="group">
                    <div class="overflow-hidden rounded-xl border border-white/10 bg-slate-950 shadow-xl shadow-black/40 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:shadow-teal-950/40">
                      <div class="flex items-center gap-1.5 border-b border-white/10 bg-slate-900 px-3 py-2">
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                      </div>
                      <img src={s.src} alt={s.title} class="block w-full" loading="lazy" />
                    </div>
                    <figcaption class="mt-4">
                      <p class="font-semibold text-white">{s.title}</p>
                      <p class="mt-1 text-sm text-slate-400">{s.text}</p>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>

          <div class="mt-16">
            <p class="mb-6 text-xs font-semibold uppercase tracking-widest text-cyan-400/90">
              Lo que ven tus vendedores
            </p>
            <div class="grid gap-8 md:grid-cols-2">
              {
                sellerScreens.map((s) => (
                  <figure class="group">
                    <div class="overflow-hidden rounded-xl border border-white/10 bg-slate-950 shadow-xl shadow-black/40 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:shadow-cyan-950/40">
                      <div class="flex items-center gap-1.5 border-b border-white/10 bg-slate-900 px-3 py-2">
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                        <span class="h-2 w-2 rounded-full bg-white/20" />
                      </div>
                      <img src={s.src} alt={s.title} class="block w-full" loading="lazy" />
                    </div>
                    <figcaption class="mt-4">
                      <p class="font-semibold text-white">{s.title}</p>
                      <p class="mt-1 text-sm text-slate-400">{s.text}</p>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Por qué ahora + 8. Modelos -->
      <section class="py-20 sm:py-24">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 lg:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-gradient-to-b from-teal-500/10 to-transparent p-8 sm:p-10">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Por qué ahora</h2>
            <p class="mt-4 leading-relaxed text-slate-300">
              Estamos en prelanzamiento. Registrarte como proveedor te da acceso anticipado. Cuando tú
              estés dentro, tus vendedores te siguen.
            </p>
          </div>
          <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 sm:p-10">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Modelos</h2>
            <p class="mt-4 leading-relaxed text-slate-300">
              Trabajamos con modelos flexibles: comisión por venta u otras opciones según contratación.
            </p>
          </div>
        </div>
      </section>

      <!-- 9. CTA final -->
      <section class="pb-24">
        <div class="mx-auto max-w-4xl px-5">
          <div
            class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-teal-600 via-teal-700 to-cyan-900 p-8 text-center shadow-2xl shadow-teal-950/50 sm:p-14"
          >
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-white/10 blur-2xl"
            >
            </div>
            <div
              class="pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-cyan-400/20 blur-2xl"
            >
            </div>
            <h2 class="relative text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              Únete al prelanzamiento
            </h2>
            <p class="relative mx-auto mt-4 max-w-lg text-teal-50/90">
              Regístrate como proveedor y accede antes. Tú traes a tus vendedores.
            </p>
            <div class="relative mt-8 flex flex-wrap justify-center gap-3">
              <a
                href={registerHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-teal-900 shadow-lg transition hover:bg-teal-50"
              >
                Quiero registrarme
              </a>
              <a
                href={mailto}
                class="inline-flex items-center rounded-full border border-white/40 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
              >
                {email}
              </a>
            </div>
            <p class="relative mt-6 text-sm text-teal-100/70">
              WhatsApp
              <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="underline hover:text-white"
                >+53 {phone}</a
              >
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/5 py-8 text-center text-sm text-slate-500">
      <p>
        <a href="/" class="transition hover:text-slate-300">renierricardo.dev</a>
        · Broker
      </p>
    </footer>

    <style is:global>
      html {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .animate-fade-in {
        animation: fade-in 0.7s ease-out both;
      }
      .animate-rise {
        animation: rise 0.75s ease-out both;
      }
      .animate-rise-delay {
        animation: rise 0.75s ease-out 0.12s both;
      }
      .animate-rise-delay-2 {
        animation: rise 0.8s ease-out 0.24s both;
      }
    </style>
  </body>
</html>
