---
const title = 'Odoo Shop — App móvil de catálogo y pedidos al por mayor';
const description =
  'Aplicación móvil de marca blanca conectada a Odoo: catálogo, carrito, pedidos y soporte WhatsApp para mayoristas y distribuidores.';
const image = '/proyectos/odoo-shop/con-banner.jpg';
const site = 'https://renierricardo.dev';
const email = 'aprezcuba24@gmail.com';
const phone = '53024637';
const whatsapp = `https://wa.me/53${phone}`;
const mailto = `mailto:${email}?subject=${encodeURIComponent('Interés en Odoo Shop')}`;

const features = [
  {
    title: 'Catálogo y promociones',
    text: 'Banners, búsqueda, categorías y listado de productos con precios e imágenes sincronizados desde Odoo.',
    icon: 'catalog',
  },
  {
    title: 'Carrito y pedidos',
    text: 'Tus clientes arman el pedido, eligen cantidades y lo envían. El cobro lo gestionas tú, fuera de la app.',
    icon: 'cart',
  },
  {
    title: 'Estados en tiempo real',
    text: 'En revisión, negociación, listo para entrega, entregado o cancelado — reflejados desde tu flujo en Odoo.',
    icon: 'status',
  },
  {
    title: 'Soporte por WhatsApp',
    text: 'Botón directo al teléfono de tu tienda para activar cuentas, negociar o resolver dudas.',
    icon: 'whatsapp',
  },
];

const screens = [
  {
    src: '/proyectos/odoo-shop/con-banner.jpg',
    title: 'Inicio',
    text: 'Banners promocionales, búsqueda y catálogo paginado.',
  },
  {
    src: '/proyectos/odoo-shop/categorias.jpg',
    title: 'Categorías',
    text: 'Filtros claros para que el comprador encuentre rápido.',
  },
  {
    src: '/proyectos/odoo-shop/producto.jpg',
    title: 'Producto',
    text: 'Detalle, precio y cantidad antes de añadir al carrito.',
  },
  {
    src: '/proyectos/odoo-shop/carrito.jpg',
    title: 'Carrito',
    text: 'Cantidades, totales y finalización del pedido.',
  },
  {
    src: '/proyectos/odoo-shop/ordenes.jpg',
    title: 'Pedidos',
    text: 'Historial visible cuando la cuenta está activa.',
  },
  {
    src: '/proyectos/odoo-shop/detalle-orden.jpg',
    title: 'Detalle',
    text: 'Líneas, totales y estado comercial del pedido.',
  },
];

const ventaMayorPoints = [
  {
    title: 'Registro sin contraseña',
    text: 'Nombre, teléfono y dirección. El dispositivo queda vinculado al contacto en Odoo.',
  },
  {
    title: 'Activación manual de clientes',
    text: 'Tú validas clientes en Odoo. Hasta entonces pueden pedir, pero sin historial completo.',
  },
  {
    title: 'Negociación comercial',
    text: 'Ajustas precios y cantidades en Odoo; el estado “En negociación” se ve en la app.',
  },
  {
    title: 'Sin pasarela de pago',
    text: 'Contado, crédito o transferencia: tus condiciones, tu operación habitual.',
  },
  {
    title: 'Notificaciones push',
    text: 'Ofertas, cambios de estado o recordatorios enviados desde Odoo a Android.',
  },
  {
    title: 'Stock en tiempo real',
    text: 'Si no hay cantidad suficiente, el pedido no se confirma y la app lo indica.',
  },
];

const faqs = [
  {
    q: '¿Mis clientes necesitan usuario y contraseña?',
    a: 'No. Se registran con nombre y teléfono. La app los reconoce por dispositivo, ideal para pedidos recurrentes.',
  },
  {
    q: '¿Puedo no activar un cliente?',
    a: 'Sí. Sin validación en Odoo puede pedir, pero no ve historial y se le invita a contactarte por WhatsApp.',
  },
  {
    q: '¿La app cobra con tarjeta?',
    a: 'No. Odoo Shop no incluye pasarela de pago. Los términos de cobro los defines tú con tus clientes.',
  },
  {
    q: '¿Dónde veo los pedidos?',
    a: 'En Odoo, como cualquier pedido de venta. La app es solo el canal de entrada móvil.',
  },
  {
    q: '¿Puedo tener varias marcas?',
    a: 'Sí. Cada tienda puede tener su propia app, branding y backend Odoo (modelo de marca blanca).',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}${image}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/proyectos/odoo-shop`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <!-- Nav -->
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-lg">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
        <a href="/" class="text-sm text-slate-400 transition hover:text-white">← renierricardo.dev</a>
        <div class="flex items-center gap-3">
          <!-- <img
            src="/proyectos/odoo-shop/logo.png"
            alt="Odoo Shop"
            class="h-8 w-8 rounded-full object-cover ring-2 ring-emerald-500/40"
          /> -->
          <span class="hidden text-sm font-semibold sm:inline">Odoo Shop</span>
        </div>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
        >
          Contactar
        </a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden pt-28 pb-20 sm:pt-32 sm:pb-28">
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-900/40 via-slate-950 to-slate-950"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-32 top-20 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-teal-500/10 blur-3xl"
        >
        </div>

        <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2 lg:gap-16">
          <div>
            <p
              class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-300"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              App móvil + Odoo ERP
            </p>
            <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-[3.25rem]">
              Tu tienda en el bolsillo de tus clientes
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
              Odoo Shop es una aplicación móvil de catálogo y pedidos con
              <strong class="font-semibold text-white">la marca de tu negocio</strong>. Tus clientes piden
              cuando quieren; tú mantienes el control comercial desde Odoo.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-6 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/25 transition hover:bg-emerald-400"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                  ><path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path></svg
                >
                Hablar por WhatsApp
              </a>
              <a
                href="#recorrido"
                class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
              >
                Ver la app
              </a>
            </div>
            <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-400">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Marca blanca
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Integrado con Odoo
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Pensado para mayoristas
              </li>
            </ul>
          </div>

          <!-- Phone mockup -->
          <div class="relative mx-auto w-full max-w-[280px] lg:max-w-[300px]">
            <div
              class="absolute -inset-8 rounded-[3rem] bg-gradient-to-br from-emerald-500/30 to-teal-600/10 blur-2xl"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-[2rem] border-[6px] border-slate-800 bg-slate-900 shadow-2xl shadow-emerald-950/50 ring-1 ring-white/10"
            >
              <div class="absolute inset-x-0 top-0 z-10 flex justify-center pt-2">
                <div class="h-5 w-24 rounded-full bg-slate-950"></div>
              </div>
              <img
                src="/proyectos/odoo-shop/con-banner.jpg"
                alt="Pantalla de inicio de Odoo Shop"
                class="block w-full"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Qué es + diagrama flujo -->
      <section class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
              La app es el canal. Odoo es tu backoffice.
            </h2>
            <p class="mt-4 text-slate-300">
              No sustituye tu ERP: lo complementa. Productos, stock, precios, validación de clientes y
              preparación de pedidos se gestionan en Odoo. La app pone la tienda en el móvil del comprador.
            </p>
          </div>

          <!-- Diagrama: App → Bridge → Odoo -->
          <div class="mt-14 overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 p-6 sm:p-10">
            <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-emerald-400/80">
              Arquitectura
            </p>
            <div class="flex flex-col items-stretch gap-4 md:flex-row md:items-center md:justify-center md:gap-0">
              <!-- App -->
              <div class="flex flex-1 flex-col items-center">
                <div
                  class="w-full max-w-[200px] rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 p-5 text-center shadow-lg shadow-emerald-900/40"
                >
                  <div
                    class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-white/15"
                  >
                    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
                      ><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M11 18h2"></path></svg
                    >
                  </div>
                  <p class="text-xs font-medium uppercase tracking-wide text-emerald-100/80">
                    Tus compradores
                  </p>
                  <p class="mt-1 text-lg font-bold text-white">App móvil</p>
                </div>
              </div>

              <!-- Arrow -->
              <div class="flex flex-col items-center px-2 md:px-4">
                <span class="mb-1 text-[10px] font-medium text-slate-400">Pedidos · Perfil</span>
                <svg class="hidden h-6 w-16 text-emerald-500 md:block" fill="none" viewBox="0 0 64 24"
                  ><path
                    d="M2 12h52M46 4l12 8-12 8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <svg class="h-8 w-6 text-emerald-500 md:hidden" fill="none" viewBox="0 0 24 32"
                  ><path
                    d="M12 2v22M4 18l8 8 8-8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <span class="mt-1 text-[10px] font-medium text-slate-400">Catálogo · Push</span>
              </div>

              <!-- Bridge -->
              <div class="flex flex-1 flex-col items-center">
                <div
                  class="w-full max-w-[200px] rounded-2xl border-2 border-emerald-500/50 bg-slate-900 p-5 text-center shadow-lg"
                >
                  <div
                    class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/15"
                  >
                    <svg class="h-6 w-6 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
                      ><path d="M8 12h8M12 8v8"></path><circle cx="12" cy="12" r="9"></circle></svg
                    >
                  </div>
                  <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Recibe la orden</p>
                  <p class="mt-1 text-lg font-bold text-emerald-300">Sincronización</p>
                </div>
              </div>

              <!-- Arrow -->
              <div class="flex flex-col items-center px-2 md:px-4">
                <span class="mb-1 text-[10px] font-medium text-slate-400">Sale orders</span>
                <svg class="hidden h-6 w-16 text-orange-400 md:block" fill="none" viewBox="0 0 64 24"
                  ><path
                    d="M2 12h52M46 4l12 8-12 8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <svg class="h-8 w-6 text-orange-400 md:hidden" fill="none" viewBox="0 0 24 32"
                  ><path
                    d="M12 2v22M4 18l8 8 8-8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                <span class="mt-1 text-[10px] font-medium text-slate-400">Stock · Precios</span>
              </div>

              <!-- Odoo -->
              <div class="flex flex-1 flex-col items-center">
                <div
                  class="w-full max-w-[200px] rounded-2xl bg-gradient-to-br from-orange-500 to-orange-700 p-5 text-center shadow-lg shadow-orange-900/40"
                >
                  <div
                    class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-white/15"
                  >
                    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
                      ><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><path d="M9 22V12h6v10"
                      ></path></svg
                    >
                  </div>
                  <p class="text-xs font-medium uppercase tracking-wide text-orange-100/80">Tu negocio</p>
                  <p class="mt-1 text-lg font-bold text-white">Odoo ERP</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature cards -->
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              features.map((f) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-500/30 hover:bg-white/[0.05]">
                  <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                    {f.icon === 'catalog' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M4 6h16M4 12h16M4 18h10" />
                      </svg>
                    )}
                    {f.icon === 'cart' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <circle cx="9" cy="20" r="1" />
                        <circle cx="17" cy="20" r="1" />
                        <path d="M3 3h2l2.4 12.3a2 2 0 002 1.7h7.6a2 2 0 002-1.6L21 8H7" />
                      </svg>
                    )}
                    {f.icon === 'status' && (
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M12 8v4l3 3" />
                        <circle cx="12" cy="12" r="9" />
                      </svg>
                    )}
                    {f.icon === 'whatsapp' && (
                      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                      </svg>
                    )}
                  </div>
                  <h3 class="font-semibold text-white">{f.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Recorrido / galería -->
      <section id="recorrido" class="py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Qué ven tus compradores</h2>
            <p class="mt-4 text-slate-300">
              Navegación inferior clara: Inicio, Carrito, Pedidos y Cuenta. Todo lo que publicas en Odoo
              aparece en la app.
            </p>
          </div>

          <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {
              screens.map((s) => (
                <figure class="group">
                  <div class="mx-auto w-full max-w-[220px] overflow-hidden rounded-[1.5rem] border-[5px] border-slate-800 bg-slate-900 shadow-xl shadow-black/40 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:shadow-emerald-950/40">
                    <img src={s.src} alt={s.title} class="block w-full" loading="lazy" />
                  </div>
                  <figcaption class="mt-4 text-center">
                    <p class="font-semibold text-white">{s.title}</p>
                    <p class="mt-1 text-sm text-slate-400">{s.text}</p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Flujo de pedido -->
      <section class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Cómo fluye un pedido</h2>
            <p class="mt-4 text-slate-300">
              Del móvil a tu ERP en segundos. Tú operas el pedido en Odoo; el comprador ve estados
              simplificados.
            </p>
          </div>

          <!-- Diagrama flujo pedido (pasos numerados) -->
          <div class="mt-14 overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 p-6 sm:p-10">
            <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-emerald-400/80">
              Flujo completo
            </p>

            <!-- Desktop lanes -->
            <div class="hidden lg:block">
              <div class="mb-6 grid grid-cols-3 gap-4 text-center text-xs font-bold uppercase tracking-wider">
                <span class="text-slate-400">Comprador</span>
                <span class="text-emerald-400">App móvil</span>
                <span class="text-orange-400">Odoo</span>
              </div>
              <div class="relative space-y-4">
                <div class="grid grid-cols-3 gap-4">
                  <div class="rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm">
                    <span
                      class="mr-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-700 text-xs font-bold"
                      >1</span
                    >
                    Navega el catálogo y añade al carrito
                  </div>
                  <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
                    Guarda el carrito en el dispositivo
                  </div>
                  <div></div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                  <div class="rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm">
                    <span
                      class="mr-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-700 text-xs font-bold"
                      >2</span
                    >
                    Pulsa Finalizar compra
                  </div>
                  <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
                    Si es la 1.ª vez: registro + dirección
                  </div>
                  <div class="rounded-xl border border-orange-500/30 bg-orange-500/15 px-4 py-3 text-sm text-orange-100">
                    Alta de contacto (res.partner)
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                  <div></div>
                  <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
                    Envía el pedido al backend
                  </div>
                  <div class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-900/30">
                    <span
                      class="mr-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/20 text-xs font-bold"
                      >3</span
                    >
                    Crea sale.order
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                  <div class="rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm">
                    <span
                      class="mr-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-700 text-xs font-bold"
                      >4</span
                    >
                    Ve confirmación o invitación a WhatsApp
                  </div>
                  <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
                    Actualiza estados al comprador
                  </div>
                  <div class="rounded-xl border border-orange-500/30 bg-orange-500/15 px-4 py-3 text-sm text-orange-100">
                    Revisar · negociar · preparar · entregar
                  </div>
                </div>
              </div>
            </div>

            <!-- Mobile steps -->
            <ol class="space-y-4 lg:hidden">
              <li class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-sm font-bold text-slate-950"
                  >1</span
                >
                <div>
                  <p class="font-semibold">Catálogo → carrito</p>
                  <p class="text-sm text-slate-400">El comprador navega y selecciona productos.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-sm font-bold text-slate-950"
                  >2</span
                >
                <div>
                  <p class="font-semibold">Finalizar compra</p>
                  <p class="text-sm text-slate-400">
                    Si es la primera vez, completa registro y dirección de entrega.
                  </p>
                </div>
              </li>
              <li class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-500 text-sm font-bold text-white"
                  >3</span
                >
                <div>
                  <p class="font-semibold">Pedido en Odoo</p>
                  <p class="text-sm text-slate-400">Se crea el pedido de venta con líneas y totales.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-sm font-bold text-slate-950"
                  >4</span
                >
                <div>
                  <p class="font-semibold">Estados y soporte</p>
                  <p class="text-sm text-slate-400">
                    Confirmación, WhatsApp si está pendiente, y seguimiento del estado.
                  </p>
                </div>
              </li>
            </ol>
          </div>

          <!-- Diagrama estados de cuenta -->
          <div class="mt-8 overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 p-6 sm:p-10">
            <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-emerald-400/80">
              Activación de cuentas de clientes
            </p>
            <div class="flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-center">
              <div
                class="flex-1 rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center"
              >
                <div
                  class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-slate-700 text-sm font-bold"
                >
                  1
                </div>
                <p class="font-bold text-white">Sin registro</p>
                <p class="mt-1 text-sm text-slate-400">Instala la app y navega el catálogo</p>
              </div>

              <div class="flex justify-center md:px-2">
                <div class="flex flex-col items-center">
                  <svg class="hidden h-5 w-10 text-slate-500 md:block" fill="none" viewBox="0 0 40 20"
                    ><path
                      d="M2 10h28M24 4l10 6-10 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  <svg class="h-8 w-5 text-slate-500 md:hidden" fill="none" viewBox="0 0 20 32"
                    ><path
                      d="M10 2v22M4 18l6 8 6-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  <span class="mt-1 max-w-[100px] text-center text-[10px] text-slate-500"
                    >Se registra y pide</span
                  >
                </div>
              </div>

              <div
                class="flex-1 rounded-2xl border-2 border-orange-500/50 bg-orange-500/10 p-5 text-center"
              >
                <div
                  class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-orange-500 text-sm font-bold text-white"
                >
                  2
                </div>
                <p class="font-bold text-orange-300">Pendiente</p>
                <p class="mt-1 text-sm text-slate-400">Puede pedir · sin historial · WhatsApp</p>
              </div>

              <div class="flex justify-center md:px-2">
                <div class="flex flex-col items-center">
                  <svg class="hidden h-5 w-10 text-emerald-500 md:block" fill="none" viewBox="0 0 40 20"
                    ><path
                      d="M2 10h28M24 4l10 6-10 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  <svg class="h-8 w-5 text-emerald-500 md:hidden" fill="none" viewBox="0 0 20 32"
                    ><path
                      d="M10 2v22M4 18l6 8 6-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  >
                  <span class="mt-1 max-w-[100px] text-center text-[10px] text-emerald-500/80"
                    >Tú validas en Odoo</span
                  >
                </div>
              </div>

              <div
                class="flex-1 rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 p-5 text-center shadow-lg shadow-emerald-900/40"
              >
                <div
                  class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-sm font-bold"
                >
                  3
                </div>
                <p class="font-bold text-white">Cuenta activa</p>
                <p class="mt-1 text-sm text-emerald-100/80">Historial completo · editar perfil</p>
              </div>
            </div>
          </div>

          <!-- Estados de pedido -->
          <div class="mt-8">
            <p class="mb-4 text-center text-sm font-medium text-slate-400">
              Estados que ve el comprador en la app
            </p>
            <div class="flex flex-wrap justify-center gap-2">
              {
                [
                  { label: 'En revisión', color: 'bg-sky-500/15 text-sky-300 border-sky-500/30' },
                  {
                    label: 'En negociación',
                    color: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
                  },
                  {
                    label: 'Listo para entrega',
                    color: 'bg-violet-500/15 text-violet-300 border-violet-500/30',
                  },
                  {
                    label: 'Entregado',
                    color: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
                  },
                  { label: 'Cancelado', color: 'bg-rose-500/15 text-rose-300 border-rose-500/30' },
                ].map((st) => (
                  <span
                    class={`rounded-full border px-4 py-1.5 text-sm font-medium ${st.color}`}
                  >
                    {st.label}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Venta al por mayor -->
      <section class="py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Pensado para negocios que venden a otros negocios</h2>
            <p class="mt-4 text-slate-300">
              Mayoristas, distribuidores y abastecimiento: control comercial sin fricción para el
              comprador recurrente.
            </p>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              ventaMayorPoints.map((p) => (
                <div class="rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-transparent p-6">
                  <h3 class="font-semibold text-emerald-300">{p.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Marca blanca -->
      <section class="border-t border-white/5 bg-slate-900/40 py-20 sm:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="grid items-center gap-12 lg:grid-cols-2">
            <div>
              <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Tu marca, tu app</h2>
              <p class="mt-4 text-slate-300">
                Odoo Shop es de <strong class="text-white">marca blanca</strong>: cada tienda tiene su
                propia aplicación con nombre, logo, colores y backend Odoo. Lista para Google Play o
                distribución directa a tus clientes.
              </p>
              <ul class="mt-8 space-y-3 text-sm text-slate-300">
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 text-emerald-400">✓</span>
                  Nombre y logo en cabecera e icono del teléfono
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 text-emerald-400">✓</span>
                  Paleta de colores acorde a tu identidad
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 text-emerald-400">✓</span>
                  Conexión a tu instancia Odoo
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 text-emerald-400">✓</span>
                  Identificador único para publicación
                </li>
              </ul>
            </div>
            <div class="relative mx-auto w-full max-w-[240px]">
              <div
                class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-emerald-500/20 to-orange-500/10 blur-xl"
              >
              </div>
              <div
                class="relative overflow-hidden rounded-[1.75rem] border-[5px] border-slate-800 shadow-2xl ring-1 ring-white/10"
              >
                <img
                  src="/proyectos/odoo-shop/listado.jpg"
                  alt="Catálogo con marca de la tienda"
                  class="block w-full"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="py-20 sm:py-24">
        <div class="mx-auto max-w-3xl px-5">
          <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Preguntas frecuentes</h2>
          <div class="mt-12 space-y-3">
            {
              faqs.map((item) => (
                <details class="group rounded-2xl border border-white/10 bg-white/[0.03] open:border-emerald-500/30 open:bg-emerald-500/5">
                  <summary class="cursor-pointer list-none px-5 py-4 font-semibold text-white marker:content-none [&::-webkit-details-marker]:hidden">
                    <span class="flex items-center justify-between gap-4">
                      {item.q}
                      <span class="text-emerald-400 transition group-open:rotate-45">+</span>
                    </span>
                  </summary>
                  <p class="border-t border-white/5 px-5 py-4 text-sm leading-relaxed text-slate-400">
                    {item.a}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="pb-24">
        <div class="mx-auto max-w-4xl px-5">
          <div
            class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-600 via-emerald-700 to-teal-900 p-8 text-center shadow-2xl shadow-emerald-950/50 sm:p-14"
          >
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-white/10 blur-2xl"
            >
            </div>
            <h2 class="relative text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              ¿Quieres tu propia Odoo Shop?
            </h2>
            <p class="relative mx-auto mt-4 max-w-lg text-emerald-50/90">
              Cuéntame sobre tu negocio y vemos juntos cómo poner el catálogo en el móvil de tus
              clientes.
            </p>
            <div class="relative mt-8 flex flex-wrap justify-center gap-3">
              <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-emerald-800 shadow-lg transition hover:bg-emerald-50"
              >
                WhatsApp
              </a>
              <a
                href={mailto}
                class="inline-flex items-center rounded-full border border-white/40 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
              >
                {email}
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/5 py-8 text-center text-sm text-slate-500">
      <p>
        <a href="/" class="transition hover:text-slate-300">renierricardo.dev</a>
        · Odoo Shop
      </p>
    </footer>

    <style is:global>
      html {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </body>
</html>
