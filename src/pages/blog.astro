---
import SeccionTitle from "../components/SeccionTitle.astro";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { transformPosts } from "../utils";

const allPosts = transformPosts(await Astro.glob("../pages/posts/*.md"));
---

<Layout
  title="Blog"
  description="Artículos del desarrollador Renier Ricardo Figueredo"
>
  <SeccionTitle title="Artículos" eyebrow="Blog" />
  <p class="mb-8 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">
    Notas técnicas sobre desarrollo web, cloud, IA y arquitectura de software.
  </p>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      allPosts.map((post: any) => (
        <PostCard
          title={post.title}
          url={post.url}
          image={post.image}
          description={post.description}
          pubDate={post.pubDate}
        />
      ))
    }
  </div>
</Layout>
