---
interface Props {
	title: string;
	class?: string;
	id?: string;
	eyebrow?: string;
}

const { title, class: classProps, id, eyebrow } = Astro.props;
---

<div class:list={["min-w-0", classProps ?? "mb-6"]} id={id}>
	{
		eyebrow && (
			<p class="mb-2 text-xs font-semibold uppercase tracking-widest text-amber-400">
				{eyebrow}
			</p>
		)
	}
	<h2 class="text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">
		{title}
	</h2>
	<div class="mt-3 h-px w-12 bg-amber-400/80" aria-hidden="true"></div>
</div>
