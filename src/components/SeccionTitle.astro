---
interface Props {
  title: string;
  class?: string;
  firstPartLength?: number;
}

const { title, class: classProps, firstPartLength = 3 } = Astro.props;
const parts = title.split("");
const fristPart = parts.slice(0, firstPartLength).join("");
const secondPart = parts.slice(firstPartLength).join("");
const baseClass = "w-full flex items-end gap-1 mb-2 min-w-0";
const className = classProps ? `${classProps} ${baseClass}` : baseClass;
---

<div class={className}>
  <h2 class="text-xl sm:text-2xl font-bold shrink-0">
    <span class="text-red-500">{fristPart}</span>{secondPart}
  </h2>
  <div class="flex-1 min-w-0 pb-1.5">
    <div class="w-full border-solid border-b-2 border-black"></div>
  </div>
</div>
