---
import Label from "./Label.astro";

interface Props {
  title: string;
  subTitle: string;
  place?: string;
  date?: string;
  items?: string[];
  class?: string;
}
const { title, subTitle, place, date, items, class: classProps } = Astro.props;
---

<div
  class:list={[
    "mb-4 flex min-w-0 flex-col gap-2 rounded-xl border border-zinc-800/80 bg-zinc-900/30 px-4 py-3 text-sm sm:flex-row sm:justify-between sm:gap-4",
    classProps,
  ]}
>
  <div class="min-w-0 break-words">
    <Label class="mb-1 text-zinc-100" label={title} />
    <p class="text-zinc-300 break-words">{subTitle}</p>
    {
      items && (
        <ul class="mt-2 list-disc space-y-1 pl-4 text-zinc-400">
          {items.map((item) => (
            <li class="break-words">{item}</li>
          ))}
        </ul>
      )
    }
  </div>
  {
    (place || date) && (
      <div class="shrink-0 text-left sm:text-right">
        {place && <p class="text-amber-400">{place}</p>}
        {date && <p class="text-zinc-500">{date}</p>}
      </div>
    )
  }
</div>
