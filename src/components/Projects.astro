---
import SeccionTitle from './SeccionTitle.astro';

type Project = {
  title: string;
  description: string;
  image: string;
  href: string;
  tag?: string;
};

const projects: Project[] = [
  {
    title: 'Vendelo360',
    description:
      'Caso de estudio: arquitectura de una plataforma B2B API-first. Backend headless, portales para proveedores, gestores y administración, e integraciones.',
    image: '/media/proyectos/broker/01-backoffice-dashboard.png',
    href: '/proyectos/broker',
    tag: 'B2B · Arquitectura · SaaS',
  },
  {
    title: 'QR Pay',
    description:
      'App gratuita para Android: guarda tus tarjetas y genera códigos QR para Transfermóvil y EnZona. CUP y MLC.',
    image: '/media/proyectos/qr-pay/tarjetas.jpg',
    href: '/proyectos/qr-pay',
    tag: 'Mobile · Fintech · Gratis',
  },
  {
    title: 'Odoo Shop',
    description:
      'App móvil white-label de catálogo y pedidos B2B, conectada a Odoo. Tus clientes piden desde el móvil; tú operas desde el ERP.',
    image: '/media/proyectos/odoo-shop/con-banner.jpg',
    href: '/proyectos/odoo-shop',
    tag: 'Mobile · Odoo · B2B',
  },
];
---

<section class="mt-16 sm:mt-20">
  <SeccionTitle title="Proyectos" id="proyectos" eyebrow="Portfolio" />
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <a
          href={project.href}
          class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/60 shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:border-amber-400/40 hover:shadow-amber-400/5"
        >
          <div class="aspect-[16/10] w-full overflow-hidden bg-zinc-800">
            <img
              src={project.image}
              alt={project.title}
              class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-5 min-w-0">
            {project.tag && (
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-amber-400 break-words">
                {project.tag}
              </p>
            )}
            <h3 class="text-lg font-bold text-zinc-50 group-hover:text-amber-400">
              {project.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400 break-words">
              {project.description}
            </p>
            <span class="mt-4 text-sm font-semibold text-amber-400 group-hover:underline">
              Ver proyecto →
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
