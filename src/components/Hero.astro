---
---

<section class="grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-14">
	<div class="mx-auto lg:mx-0">
		<div
			class="relative h-40 w-40 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-xl shadow-black/40 sm:h-48 sm:w-48"
		>
			<img
				src="/personal_foto.jpg"
				alt="Retrato de Renier Ricardo Figueredo"
				class="h-full w-full object-cover"
				width="192"
				height="192"
			/>
		</div>
	</div>

	<div class="min-w-0 text-center lg:text-left">
		<p class="text-sm font-medium uppercase tracking-widest text-amber-400">
			Desarrollador Senior Full-Stack
		</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl lg:text-5xl">
			Renier Ricardo Figueredo
		</h1>
		<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-zinc-400 lg:mx-0">
			Construyo plataformas web y móviles con Python, Node.js y React. Desde sistemas
			API-first y fintech hasta integraciones con Odoo y AWS — con buenas prácticas,
			arquitectura clara y foco en producto.
		</p>
		<div class="mt-7 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
			<a
				href="#proyectos"
				class="inline-flex items-center rounded-lg bg-amber-400 px-4 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-amber-300"
			>
				Ver proyectos
			</a>
			<a
				href="/cv"
				class="inline-flex items-center rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-zinc-100 transition hover:border-zinc-500 hover:bg-zinc-800"
			>
				CV completo
			</a>
			<a
				href="#contacto"
				class="inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-semibold text-zinc-300 transition hover:text-amber-400"
			>
				Contacto
			</a>
		</div>
	</div>
</section>
