---
import { transformPosts } from "../utils";
import SeccionTitle from "./SeccionTitle.astro";
import PostCard from "./PostCard.astro";

const lastPosts = transformPosts(await Astro.glob("../pages/posts/*.md")).slice(
	0,
	3
);
---

<section class="mt-16 sm:mt-20">
	<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div class="min-w-0">
			<SeccionTitle title="Últimos artículos" eyebrow="Blog" />
		</div>
		<a
			href="/blog"
			class="mb-2 shrink-0 text-sm font-semibold text-amber-400 hover:underline"
		>
			Ver todos →
		</a>
	</div>
	<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			lastPosts.map((post: any) => (
				<PostCard
					title={post.title}
					url={post.url}
					image={post.image}
					description={post.description}
					pubDate={post.pubDate}
				/>
			))
		}
	</div>
</section>
