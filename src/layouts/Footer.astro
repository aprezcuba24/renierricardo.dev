---
const year = new Date().getFullYear();
const social = [
	{
		label: "GitHub",
		href: "https://github.com/aprezcuba24",
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/renier-ricardo-figueredo-b9473536/",
	},
	{
		label: "Email",
		href: "mailto:aprezcuba24@gmail.com",
	},
];
---

<footer class="mt-auto border-t border-zinc-800 bg-zinc-950 no-print">
	<div
		class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
	>
		<div class="min-w-0">
			<p class="text-sm font-medium text-zinc-200">Msc. Renier Ricardo Figueredo</p>
			<p class="mt-1 text-xs text-zinc-500">© {year} · Habana, Cuba</p>
		</div>
		<ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
			{
				social.map((item) => (
					<li>
						<a
							href={item.href}
							class="text-zinc-400 transition-colors hover:text-amber-400"
							target={item.href.startsWith("http") ? "_blank" : undefined}
							rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
