---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PageMetaTags from "../components/pageMetaTags.astro";

interface Props {
	title?: string;
	description: string;
	image?: string;
	narrow?: boolean;
}

const { title, description, image, narrow = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<PageMetaTags title={title} description={description} image={image} />
	</head>
	<body class="min-h-screen overflow-x-hidden bg-zinc-950 font-sans text-zinc-100 antialiased">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-amber-400 focus:px-3 focus:py-2 focus:text-zinc-950"
		>
			Saltar al contenido
		</a>
		<Header />
		<main
			id="contenido"
			class:list={[
				"mx-auto w-full min-w-0 px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14",
				narrow ? "max-w-article" : "max-w-6xl",
			]}
		>
			<slot />
		</main>
		<Footer />
		<style is:global>
			html {
				scroll-behavior: smooth;
			}

			img,
			video,
			svg {
				max-width: 100%;
				height: auto;
			}

			a {
				overflow-wrap: anywhere;
			}

			:focus-visible {
				outline: 2px solid #fbbf24;
				outline-offset: 2px;
			}

			@media print {
				body {
					background: white !important;
					color: #18181b !important;
				}

				header,
				footer,
				.no-print {
					display: none !important;
				}

				main {
					max-width: none !important;
					padding: 0 !important;
				}

				.cv-print,
				.cv-print * {
					color: #18181b !important;
					border-color: #d4d4d8 !important;
					background: transparent !important;
					box-shadow: none !important;
				}

				.cv-print a {
					color: #18181b !important;
					text-decoration: underline;
				}

				a {
					color: inherit !important;
					text-decoration: underline;
				}
			}
		</style>
	</body>
</html>
