---
import Header from "./Header.astro";
import Sidebar from "./Sidebar.astro";
import AuthorCard from "../components/AuthorCard.astro";
import Footer from "./Footer.astro";
import PageMetaTags from "../components/pageMetaTags.astro";

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;700&display=swap"
			rel="stylesheet"
		/>
		<PageMetaTags title={title} description={description} image={image} />
	</head>
	<body class="overflow-x-hidden">
		<Header title={title} />
		<div class="flex w-full justify-center px-4 sm:px-5">
			<div class="flex w-full max-w-3xl pt-8 sm:pt-10 gap-5 min-w-0">
				<div class="w-full min-w-0 sm:flex-1">
					<div class="sm:hidden w-full mb-5">
						<AuthorCard />
					</div>
					<slot />
				</div>
				<div class="hidden sm:block w-40 shrink-0">
					<Sidebar />
				</div>
			</div>
		</div>
		<Footer />
		<style is:global>
			html {
				font-family: system-ui, sans-serif;
				background-size: 224px;
				font-family: "Poppins";
			}

			img,
			video,
			svg {
				max-width: 100%;
				height: auto;
			}

			a {
				overflow-wrap: anywhere;
			}
		</style>
	</body>
</html>
